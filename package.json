{
  "name": "h-sdk",
  "private": true,
  "description": "H_SDK — mundo H; vendor externo del scriptorium: consume skills-scriptorium y @zeus/* por registry",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/edge-zeus",
    "packages/app-prueba-hm"
  ],
  "scripts": {
    "typecheck": "bun x tsc -p packages/core --noEmit && bun x tsc -p packages/edge-zeus --noEmit && bun x tsc -p packages/app-prueba-hm --noEmit",
    "typecheck:core": "bun x tsc -p packages/core --noEmit",
    "typecheck:edge-zeus": "bun x tsc -p packages/edge-zeus --noEmit",
    "typecheck:app": "bun x tsc -p packages/app-prueba-hm --noEmit",
    "test:reachability": "bun test packages/app-prueba-hm/src/reachability.test.ts packages/app-prueba-hm/src/composition.test.ts packages/app-prueba-hm/src/vertical.test.ts",
    "skills:sync": "alephscript-skills-sync --runtime claude",
    "demo": "bun run packages/app-prueba-hm/src/main.ts"
  },
  "devDependencies": {
    "@alephscript/skills-scriptorium": "0.12.0",
    "bun-types": "^1.3.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@zeus/acta-kit": "0.1.2",
    "@zeus/arg-domain": "0.1.0",
    "@zeus/arg-player-mcp": "0.1.0",
    "@zeus/arg-runtime": "0.1.1",
    "@zeus/ciudad": "^0.1.1",
    "@zeus/feed-kit": "0.3.1",
    "@zeus/game-engine": "^0.1.4",
    "@zeus/linea-kit": "0.4.0",
    "@zeus/mockdatas-ciudad": "0.1.0",
    "@zeus/onfalo-fixture": "0.1.1",
    "@zeus/protocol": "^0.4.1",
    "@zeus/startpack-ciudad": "^0.1.1",
    "@zeus/ui-3d-kit": "^0.1.4",
    "@zeus/view-kit": "^0.1.5",
    "three": "^0.185.1"
  }
}
