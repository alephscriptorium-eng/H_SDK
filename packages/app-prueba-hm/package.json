{
  "name": "@h-sdk/app-prueba-hm",
  "version": "0.1.0",
  "description": "Composition root Bun/TS de la experiencia Prueba-H-M.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/main.ts",
    "./mcp": "./src/server.ts",
    "./catalog": "./src/catalog.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "mcp": "bun --env-file=.env run src/server.ts",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@h-sdk/core": "workspace:*",
    "@h-sdk/edge-zeus": "workspace:*",
    "@zeus/arg-domain": "0.1.0",
    "@zeus/arg-runtime": "0.1.1",
    "@zeus/arg-player-mcp": "0.1.0",
    "@zeus/onfalo-fixture": "0.1.1",
    "@zeus/mockdatas-ciudad": "0.1.0"
  }
}
